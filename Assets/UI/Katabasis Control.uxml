<ui:UXML xmlns:ui="UnityEngine.UIElements" xmlns:uie="UnityEditor.UIElements" editor-extension-mode="False">
    <Style src="project://database/Assets/UI/Katabasis%20Control.uss?fileID=7433441132597879392&amp;guid=6b81eab8ab4e17f42a0b1f71b563c5d5&amp;type=3#Katabasis Control"/>
    <ui:GroupBox name="GroupBox" style="height: 100%; flex-direction: row; background-color: rgba(59, 59, 59, 0); border-top-width: 0; border-right-width: 0; border-bottom-width: 0; border-left-width: 0; width: 100%; margin-top: 0; margin-right: 0; margin-bottom: 0; margin-left: 0; padding-top: 10px; padding-right: 10px; padding-bottom: 10px; padding-left: 10px; scale: 1 1;">
        <ui:ListView name="salleslist" enabled="true" fixed-item-height="25" show-border="false" virtualization-method="FixedHeight" data-source="project://database/Assets/Scripts/UI/TunnelListUI.asset?fileID=11400000&amp;guid=50a3821cb77427f419531ead4b50c4f1&amp;type=2#TunnelListUI" data-source-type="TunneUIList, Assembly-CSharp" data-source-path="" allow-add="false" allow-remove="false" header-title="Salles" show-add-remove-footer="false" show-foldout-header="false" horizontal-scrolling="false" show-alternating-row-backgrounds="None" selection-type="None"/>
        <ui:VisualElement style="flex-grow: 1;">
            <ui:GroupBox style="height: 100%; left: auto; right: auto; top: auto; bottom: auto; width: auto;">
                <ui:Button text="Lock On Track" name="freemotionbt" style="height: 36px; width: 128px; left: 59px; top: 32px; position: absolute;"/>
                <ui:Button text="Edit Mode" name="editmodebt" style="height: 36px; width: 128px; left: 59px; top: 106px; position: absolute;"/>
                <ui:Button text="Play/Pause" name="playpause" style="height: 36px; width: 128px; left: 59px; top: 186px; position: absolute;"/>
                <ui:VisualElement name="capture-section" class="capture-section">
                    <ui:Label text="CAPTURE" class="capture-title"/>
                    <ui:Toggle label="B&amp;W" name="capture-black-and-white" class="capture-toggle"/>
                    <ui:VisualElement class="capture-threshold-row">
                        <ui:Label text="Threshold" class="capture-control-label"/>
                        <ui:Slider name="capture-threshold" low-value="0" high-value="1" value="0" class="capture-threshold"/>
                        <ui:Label text="0.00" name="capture-threshold-value" class="capture-threshold-value"/>
                    </ui:VisualElement>
                    <ui:Button text="Capture" name="capture-button" class="capture-button"/>
                    <ui:Label text="Ready" name="capture-status" class="capture-status"/>
                </ui:VisualElement>
            </ui:GroupBox>
        </ui:VisualElement>
        <ui:GroupBox/>
        <ui:ListView name="tunnelslist"/>
    </ui:GroupBox>
</ui:UXML>
