  m_Script: {fileID: 11500000, guid: 3dce580c03fa4404bb6d87662050fbf1, type: 3}
  m_Name: 
  m_EditorClassIdentifier: Unity.VisualEffectGraph.Editor::UnityEditor.VFX.Operator.CustomHLSL
  m_UIIgnoredErrors: []
  m_Parent: {fileID: 114350483966674976}
  m_Children: []
  m_UIPosition: {x: 731, y: 558}
  m_UICollapsed: 0
  m_UISuperCollapsed: 0
  m_InputSlots:
  - {fileID: 8926484042661616063}
  - {fileID: 8926484042661616075}
  m_OutputSlots:
  - {fileID: 8926484042661616080}
  m_OperatorName: Custom HLSL
  m_HLSLCode: "float3 GreenDespill(float3 In, float4 Params)\n{\n    float Threshold  
    = Params.x;\n    float Softness    = Params.y;\n    float Strength    = Params.z;\n   
    float DesatAmount = Params.w;\n\n    float greenDominance = In.g - max(In.r,
    In.b);\n    float mask = smoothstep(Threshold, Threshold + Softness, greenDominance);\n\n   
    float neutralG = max(In.r, In.b);\n\n    float3 color = In;\n    color.g = lerp(color.g,
    neutralG, mask * Strength);\n\n    float luma = dot(color, float3(0.299, 0.587,
    0.114));\n    float3 gray = float3(luma, luma, luma);\n    color = lerp(color,
    gray, mask * DesatAmount);\n\n    return color;\n}"
  m_ShaderFile: {fileID: 0}
  m_AvailableFunctions:
    selection: GreenDespill
    selectedIndex: 0
